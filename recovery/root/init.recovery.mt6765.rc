on init
    # Debug recovery only: permit ADB without decrypting /data/adb_keys.
    setprop ro.adb.secure.recovery 0
    setprop sys.usb.configfs 1
    setprop sys.usb.controller musb-hdrc
    setprop sys.usb.ffs.aio_compat 1

on fs
    write /sys/class/udc/musb-hdrc/device/cmode 2

on boot
    start s17-super-label
    setprop sys.usb.config adb

# Reapply immediately before USB switches into fastbootd.
on property:sys.usb.config=fastboot
    exec_start s17-super-label

service s17-super-label /system/bin/sh /system/bin/s17-super-label.sh
    class core
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
