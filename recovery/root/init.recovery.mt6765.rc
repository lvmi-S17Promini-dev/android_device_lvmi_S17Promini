on init
    # Debug recovery only: permit ADB without decrypting /data/adb_keys.
    setprop ro.adb.secure.recovery 0
    setprop sys.usb.configfs 1
    setprop sys.usb.controller musb-hdrc
    setprop sys.usb.ffs.aio_compat 1

on fs
    write /sys/class/udc/musb-hdrc/device/cmode 2

on boot
    # Proven manually on this device. Change the /dev node label, not super data.
    # Existing userdebug policy permits init -> su; su is already permissive.
    exec u:r:su:s0 root root -- /system/bin/chcon u:object_r:super_block_device:s0 /dev/block/mmcblk0p32
    setprop sys.usb.config adb
