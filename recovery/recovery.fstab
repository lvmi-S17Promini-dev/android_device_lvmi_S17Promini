# Actual stock logical partitions.
system /system ext4 ro wait,logical
vendor /vendor ext4 ro wait,logical
product /product ext4 ro wait,logical
/dev/block/by-name/cache /cache ext4 noatime,nosuid,nodev,discard wait,check
# Stock mounts md_udc at /metadata; do not substitute GPT metadata.
/dev/block/by-name/md_udc /metadata ext4 noatime,nosuid,nodev,discard wait
# Phase 1 does not implement FBE decryption. Do not format data for testing.
/dev/block/by-name/userdata /data ext4 noatime,nosuid,nodev,inlinecrypt wait,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption
/dev/block/by-name/para /misc emmc defaults defaults
/dev/block/by-name/boot /boot emmc defaults defaults
/dev/block/by-name/recovery /recovery emmc defaults defaults
/dev/block/by-name/vbmeta /vbmeta emmc defaults defaults
/dev/block/by-name/super /super emmc defaults defaults
