# Debug-only charger ADB, independent of /data and the normal adbd APEX.
# Prepare FunctionFS before the stock vendor's on-charger mount.
on init && property:ro.bootmode=charger && property:ro.debuggable=1
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mkdir /config/usb_gadget/g1 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/ffs.adb

# The stock vendor first selects HID for KPOC. Wait for that action to
# finish, then use the platform's normal USB teardown before selecting ADB.
on property:sys.usb.state=hid && property:ro.bootmode=charger && property:ro.debuggable=1
    setprop sys.usb.config none

on property:sys.usb.state=none && property:ro.bootmode=charger && property:ro.debuggable=1
    setprop sys.usb.controller musb-hdrc
    setprop vendor.usb.controller musb-hdrc
    setprop vendor.usb.vid 0x0E8D
    setprop vendor.usb.pid 0x201C
    setprop vendor.usb.acm_cnt 0
    setprop vendor.usb.acm_enable 0
    setprop sys.usb.ffs.aio_compat 1
    write /sys/class/udc/musb-hdrc/device/cmode 2
    write /config/usb_gadget/g1/idProduct 0x201C
    setprop service.adb.root 1
    setprop sys.usb.config adb
    start s17-charger-adbd

service s17-charger-adbd /system/bin/s17-charger-adbd --root_seclabel=u:r:su:s0 --device_banner=device
    class charger
    user root
    group root
    socket adbd seqpacket 660 system system
    disabled
    seclabel u:r:adbd:s0

on property:sys.usb.config=none && property:ro.bootmode=charger && property:ro.debuggable=1
    stop s17-charger-adbd

on property:init.svc.s17-charger-adbd=stopped && property:ro.bootmode=charger && property:ro.debuggable=1
    setprop sys.usb.ffs.ready 0

# class_stop charger handles the debug daemon when charging continues into
# Android. Restore the normal userdebug privilege default for APEX adbd.
on late-init && property:ro.bootmode=charger && property:ro.debuggable=1
    stop s17-charger-adbd
    setprop service.adb.root 0
