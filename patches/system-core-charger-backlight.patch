 void HealthdDraw::blank_screen(bool blank) {
     if (!graphics_available) return;
+    if (blank) {
+        remember_backlight_brightness();
+        // Write while the display/PWM clocks are still active. Writing after
+        // FB_BLANK_POWERDOWN can update the cached level without turning off
+        // the physical backlight on some panels.
+        set_backlight_brightness(0);
+    }
     gr_fb_blank(blank);
+    if (!blank) {
+        set_backlight_brightness(backlight_brightness_);
+    }
+}
+
+void HealthdDraw::remember_backlight_brightness() {
+    if (backlight_path_.empty()) return;
+    std::string value;
+    int brightness;
+    if (android::base::ReadFileToString(backlight_path_, &value) &&
+        android::base::ParseInt(android::base::Trim(value), &brightness) && brightness > 0) {
+        backlight_brightness_ = brightness;
+    }
+}
+
+void HealthdDraw::set_backlight_brightness(int brightness) {
+    if (backlight_path_.empty()) return;
+    if (!android::base::WriteStringToFile(std::to_string(brightness), backlight_path_)) {
+        LOGE("backlight: cannot write %d to %s: %s\n", brightness, backlight_path_.c_str(),
+             std::strerror(errno));
+        return;
+    }
+    KLOG_INFO("charger", "backlight: brightness=%d\n", brightness);
 }

